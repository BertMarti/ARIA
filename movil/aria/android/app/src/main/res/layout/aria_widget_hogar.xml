<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Hogar: vigilancia, cámaras y luces. Solo clases que admite RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hogar_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/widget_logo"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#38d6ff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="@string/widget_hogar" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/hogar_vigilancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#e8fbff"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2" />
        <TextView
            android:id="@+id/hogar_camaras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#9fb3c8"
            android:textSize="13sp"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/hogar_luces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9fb3c8"
            android:textSize="13sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
