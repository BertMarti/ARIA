# HTTPS con la CA interna de Caddy (certificado autofirmado, es lo esperado).
# El certificado se emite "bajo demanda" para cualquier nombre/IP con el que
# accedas, pero solo si la app lo autoriza (ARIA_HOSTS en .env) mediante el
# endpoint /internal/tls-ask.
{
	# Los navegadores no envian SNI cuando se accede por IP: se usa la IP LAN.
	default_sni {$ARIA_LAN_IP}
	skip_install_trust
	on_demand_tls {
		ask http://app:8000/internal/tls-ask
	}
}

http:// {
	redir https://{host}{uri} permanent
}

# Compartir → «Enviar a la tele»: las teles de casa no aceptan el certificado propio, así que leen el vídeo que emite
# el navegador por HTTP en este puerto. Solo /flujo/<token>/… (el token lo valida la app y caduca) y solo desde la red local;
# por HTTPS (y por tanto por Cloudflare) /flujo no existe.
http://:8095 {
	@fuera not remote_ip private_ranges
	respond @fuera 403
	handle /flujo/* {
		reverse_proxy app:8000 {
			flush_interval -1
		}
	}
	respond 404
}

https:// {
	tls internal {
		on_demand
	}
	# El endpoint de autorizacion solo es para Caddy, no para el exterior.
	respond /internal/* 404
	respond /flujo/* 404
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# «?»: solo si la app no la ha puesto ya (evita duplicarla)
		?Permissions-Policy "microphone=(self), camera=(), geolocation=(self)"
	}
	# reverse_proxy también pasa los WebSocket (/api/voz/despertar, «manos libres»).
	reverse_proxy app:8000 {
		flush_interval -1
	}
}
