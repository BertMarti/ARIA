# ARIA - configuracion. Copia este archivo a .env (install.sh lo hace por ti).
# NUNCA subas .env al repositorio.

# --- Acceso (administrador inicial para entrar desde casa; más usuarios en Ajustes → Usuarios) ---
ARIA_USER=admin
# Contrasena de acceso. install.sh genera una aleatoria si creas .env con el.
ARIA_PASSWORD=cambia-esta-contrasena
# Clave para firmar la cookie de sesion (cadena larga aleatoria: openssl rand -hex 32).
ARIA_SECRET=cambia-este-secreto

# --- Inicio de sesión único (Cloudflare Access, opcional) ---
# Para entrar por el dominio público sin escribir contraseña. Con TEAM o AUD vacíos el SSO queda desactivado.
# Dominio de tu equipo de Zero Trust (Zero Trust → Configuración → Personalizado), p. ej. mi-equipo.cloudflareaccess.com
ARIA_CF_ACCESS_TEAM=
# Etiqueta AUD (64 caracteres hexadecimales) de la aplicación ARIA en Zero Trust → Access → Applications.
ARIA_CF_ACCESS_AUD=
# Emails (separados por comas) que son SIEMPRE administradores: se crean solos en su primer acceso
# y no se pueden eliminar ni degradar desde Ajustes → Usuarios.
ARIA_ADMIN_EMAILS=

# --- Red ---
# IP de la LAN de la Raspberry Pi (install.sh la detecta con hostname -I).
ARIA_LAN_IP=
# Nombres/IPs autorizados para emitir certificado HTTPS y para el acceso (separados por comas).
ARIA_HOSTS=
# UID/GID con el que corre la app (para escribir en ./data). install.sh los rellena.
ARIA_UID=1000
ARIA_GID=1000

# --- Modelo local (Ollama) ---
# Modelo por defecto. Para una Pi de 8 GB: llama3.2:3b, qwen2.5:3b, gemma2:2b...
ARIA_MODEL=llama3.2:3b
# Tiempo que Ollama mantiene el modelo cargado en RAM tras la ultima peticion.
OLLAMA_KEEP_ALIVE=5m
# Limite de memoria del contenedor de Ollama.
OLLAMA_MEM_LIMIT=5g
# Tamano de contexto (tokens). Menos = menos RAM.
ARIA_NUM_CTX=4096
# Zona horaria para la herramienta fecha_hora.
ARIA_TZ=Europe/Madrid

# --- Cerebros (cadena de proveedores de IA gratuitos) ---
# Se prueban en este orden; si uno falla (límite de uso, clave, tiempo) se pasa al siguiente.
# El orden y la activación también se cambian en Ajustes → Cerebros (data/cerebros.json manda sobre esta línea).
ARIA_CEREBROS=ollama_cloud,groq,gemini,local
# Ollama Cloud: sin clave, usa tu cuenta (docker exec -it aria-ollama ollama signin).
ARIA_MODELO_OLLAMA_CLOUD=gpt-oss:120b-cloud
# Groq: clave gratuita en https://console.groq.com/keys (vacía = se omite).
GROQ_API_KEY=
ARIA_MODELO_GROQ=openai/gpt-oss-120b
# Google Gemini: clave gratuita en https://aistudio.google.com/apikey (vacía = se omite).
# Aviso: en el plan gratuito Google puede usar los mensajes para mejorar sus productos.
GEMINI_API_KEY=
ARIA_MODELO_GEMINI=gemini-3.1-flash-lite
# Nombre con el que ARIA trata al usuario.
ARIA_NOMBRE_USUARIO=

# --- Búsqueda en internet (SearXNG, contenedor interno aria-searxng) ---
# Clave interna de SearXNG. install.sh genera una aleatoria si está vacía (openssl rand -hex 32).
# No hay puertos publicados: solo ARIA habla con el buscador (configuración en ./searxng/settings.yml).
SEARXNG_SECRET=
# Límite de memoria del contenedor de SearXNG.
SEARXNG_MEM_LIMIT=384m

# --- Panel de servicios ---
# Desde el contenedor, el host se alcanza con host.docker.internal.
SHIELD_DNS_HOST=host.docker.internal
SHIELD_DNS_PORT=53
SHIELD_WEB_PORT=8443
HEIMDALL_HOST=host.docker.internal
HEIMDALL_PORT=51843

# --- Integraciones del laboratorio (opcionales) ---
# Si se dejan vacías, ARIA muestra la tarjeta como "no conectado". install.sh las
# rellena solas desde ../SHIELD-DNS/.env y ../HEIMDALL/.env si esos archivos existen.
# Aviso: quien inicie sesión en ARIA puede copiar estas contraseñas desde Inicio.
# SHIELD-DNS (Pi-hole v6). URL por defecto: http://<ARIA_LAN_IP>:8080
SHIELD_URL=
# Contraseña de la web de Pi-hole (PIHOLE_PASSWORD en ../SHIELD-DNS/.env).
SHIELD_PASSWORD=
# HEIMDALL (wg-easy v15). URL por defecto: https://<ARIA_LAN_IP>:51843 (certificado autofirmado).
VPN_URL=
# Usuario y contraseña de administración (WG_ADMIN_USER / WG_ADMIN_PASSWORD en ../HEIMDALL/.env).
VPN_USER=
VPN_PASSWORD=

# --- Spotify (opcional; el control de reproduccion requiere Premium) ---
# Crea una app en https://developer.spotify.com/dashboard y anade esta
# Redirect URI exactamente igual. Spotify exige HTTPS (salvo loopback).
# Spotify y Netflix están aparcados: ni herramientas ni tarjetas salvo que pongas 1 (después: docker compose up -d).
ARIA_SPOTIFY=0
ARIA_NETFLIX=0
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- Voz (opcional; valores por defecto razonables) ---
# ARIA habla con la voz femenina «Leda» de Gemini (usa GEMINI_API_KEY, gratis) y, si falla o se agota
# la cuota, con Piper en la Pi (voz femenina «F»). ARIA_TTS=local para usar siempre la de la Pi.
# ARIA_TTS=gemini
# Gratis: 3 frases/minuto por modelo; se rota entre estos (":plano" = sin indicaciones de estilo).
# ARIA_TTS_MODELOS=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts,gemini-3.8-flash-tts:plano
# ARIA_TTS_VOZ=Leda
# La transcripción usa GROQ_API_KEY (Whisper de Groq) y, si falla, el contenedor aria-voz.
# ARIA_STT_GROQ_MODELO=whisper-large-v3-turbo
# Transcripciones por usuario: por minuto y por hora.
# ARIA_VOZ_STT_MINUTO=12
# ARIA_VOZ_STT_HORA=200
# Núcleos que usa Whisper local y confianza mínima para la palabra «Aria» (0-1).
# VOZ_HILOS=4
# VOZ_CONFIANZA=0.6

# --- Imágenes / visión (opcional) ---
# Proveedores con visión, en orden (usan GEMINI_API_KEY y GROQ_API_KEY). «no» apaga las imágenes.
# El modelo local nunca se usa para imágenes.
# ARIA_VISION=gemini,groq
# ARIA_MODELO_VISION_GEMINI=gemini-3.5-flash-lite
# ARIA_MODELO_VISION_GROQ=qwen/qwen3.8-27b
# Imágenes por usuario: por minuto y por hora.
# ARIA_VISION_MINUTO=6
# ARIA_VISION_HORA=60
# Tiempo en el resumen de buenos días (Open-Meteo, sin clave). Vacío = sin tiempo.
# «Ciudad, Provincia» elige el resultado de España de esa provincia. ARIA_LAT/ARIA_LON (opcionales) evitan geocodificar.
ARIA_CIUDAD=
ARIA_LAT=
ARIA_LON=

# --- Agentes Redes y Seguridad ---
# Única red que ARIA puede escanear (IPv4 privada, /16 o menor). Todo lo demás se rechaza.
# install.sh las detecta (red de la interfaz principal y puerta de enlace). Si no, pon las de tu casa,
# p. ej. ARIA_RED_PERMITIDA=192.168.1.0/24 y ARIA_ROUTER_IP=192.168.1.1.
ARIA_RED_PERMITIDA=
ARIA_ROUTER_IP=

# --- Control parental (pausar internet / bloquear servicios por dispositivo, vía SHIELD-DNS) ---
# 0 = desactivado. El router (ARIA_ROUTER_IP) y esta máquina (ARIA_LAN_IP) nunca se pueden pausar; aquí van más IP
# protegidas, separadas por comas. Es bloqueo por DNS: no frena DNS fijo, DoH/DoT ni VPN.
ARIA_CONTROL=1
ARIA_CONTROL_PROTEGIDOS=

# --- Avisos, Telegram y notificaciones push ---
# Dirección pública de ARIA (túnel de Cloudflare). Se usa para comprobar que se puede entrar desde fuera
# (cada 5 min; 200 o 302 = bien) y para el botón «Abrir ARIA» de los avisos. Vacía = sin ese chequeo.
# Si no usas dominio propio, déjala vacía (si no, recibirás avisos de «no se puede entrar desde fuera»).
ARIA_URL_PUBLICA=
# Token del bot de Telegram (créalo con @BotFather). Vacío = bot apagado. Sin webhook: long polling.
TELEGRAM_BOT_TOKEN=
# Claves VAPID de las notificaciones push (las genera install.sh si faltan; si se cambian, hay que volver
# a activar las notificaciones en cada dispositivo). VAPID_SUBJECT: contacto para los servicios push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aria.invalid
# Las rutinas (Ajustes → Rutinas) y «resumir enlaces» no necesitan configuración: usan los cerebros en la nube
# de arriba y los canales de avisos. Límites fijos: 10 rutinas por usuario, mínimo cada hora, 90 s por ejecución.

# --- Módulos (docs/MODULOS.md) ---
# Módulos de la carpeta modulos/ que se cargan al arrancar: vacío o * = todos, «-» = ninguno, o una lista
# separada por comas (p. ej. uptime,mi-app). Son código que corre dentro de ARIA: instala solo los de confianza.
ARIA_MODULOS=
# Módulo «uptime» (opcional): webs públicas que vigilar (separadas por comas, máx. 10) y cada cuántos minutos.
# Vacío = solo la herramienta del chat «¿responde example.org?», sin avisos.
UPTIME_URLS=
UPTIME_INTERVALO_MIN=5
